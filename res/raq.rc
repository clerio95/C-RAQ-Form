#include <windows.h>
#include "versao.h"   /* gerado pelo Makefile */

/* 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID: manifesto do próprio executável. */
1 RT_MANIFEST "raq.manifest"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION    RAQ_VERSAO_NUM
  PRODUCTVERSION RAQ_VERSAO_NUM
  FILEOS         VOS_NT_WINDOWS32
  FILETYPE       VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "FileDescription", "Formulario para Registro da Analise da Qualidade"
      VALUE "FileVersion",     RAQ_VERSAO_STR
      VALUE "InternalName",    "RAQ"
      VALUE "OriginalFilename","RAQ.exe"
      VALUE "ProductName",     "RAQ Form Filler"
      VALUE "ProductVersion",  RAQ_VERSAO_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END
